document.addEventListener("DOMContentLoaded", function () {
  const numeroWhatsApp = "5511959434285";

  const formularios = {
    empresarial: document.getElementById("formEmpresarial"),
    semCnpj: document.getElementById("formSemCnpj"),
    troca: document.getElementById("formTroca")
  };

  function fecharFormularios() {
    Object.values(formularios).forEach(function (formulario) {
      formulario.hidden = true;
    });
  }

  document.querySelectorAll("[data-abrir]").forEach(function (botao) {
    botao.addEventListener("click", function () {
      fecharFormularios();

      const escolhido = formularios[botao.dataset.abrir];

      if (escolhido) {
        escolhido.hidden = false;
        escolhido.scrollIntoView({
          behavior: "smooth",
          block: "start"
        });
      }
    });
  });

  document.querySelectorAll("[data-voltar]").forEach(function (botao) {
    botao.addEventListener("click", function () {
      fecharFormularios();

      document.getElementById("cotacao").scrollIntoView({
        behavior: "smooth",
        block: "start"
      });
    });
  });

  Object.entries(formularios).forEach(function ([tipo, formulario]) {
    if (!formulario) return;

    formulario.addEventListener("submit", function (evento) {
      evento.preventDefault();

      const campos = new FormData(formulario);
      const obter = function (nome) {
        return (campos.get(nome) || "").toString().trim() || "Não informado";
      };

      const titulos = {
        empresarial: "Cotação de plano empresarial",
        semCnpj: "Cotação de plano sem CNPJ",
        troca: "Solicitação de troca de plano"
      };

      const linhas = [
        "Olá, André! Gostaria de solicitar atendimento.",
        "",
        titulos[tipo],
        "",
        "CNPJ: " + obter("cnpj"),
        "Formação acadêmica/curso: " + obter("formacao"),
        "Plano atual: " + obter("planoAtual"),
        "Beneficiários e idades: " + obter("beneficiarios"),
        "Região/cidade: " + obter("regiao"),
        "Hospitais e laboratórios preferidos: " + obter("preferencias"),
        "O que gostaria de melhorar: " + obter("motivo")
      ];

      const mensagem = linhas.join("\n");
      const url = "https://wa.me/" + numeroWhatsApp +
        "?text=" + encodeURIComponent(mensagem);

      window.open(url, "_blank");
    });
  });

  const ano = document.getElementById("year");
  if (ano) {
    ano.textContent = new Date().getFullYear();
  }

  const compartilhar = document.getElementById("shareButton");

  if (compartilhar) {
    compartilhar.addEventListener("click", async function () {
      const dados = {
        title: "André Linares | Planos de Saúde",
        text: "Conheça meu cartão digital e solicite sua cotação!",
        url: window.location.href
      };

      if (navigator.share) {
        try {
          await navigator.share(dados);
        } catch (erro) {
          // O usuário pode cancelar o compartilhamento.
        }
      } else {
        try {
          await navigator.clipboard.writeText(dados.url);
          alert("Link do cartão copiado!");
        } catch (erro) {
          alert("Copie o link pela barra do navegador.");
        }
      }
    });
  }
});
