document.addEventListener("DOMContentLoaded", function () {
  const numero = "5511959434285";

  function configurarCampo(seletor, campoId, valorExibido) {
    const select = document.querySelector(seletor);
    const campo = document.getElementById(campoId);

    if (!select || !campo) return;

    function atualizar() {
      const mostrar = select.value === valorExibido;
      campo.hidden = !mostrar;

      campo.querySelectorAll("input, textarea, select").forEach(function (item) {
        item.required = mostrar;
        if (!mostrar) item.value = "";
      });
    }

    select.addEventListener("change", atualizar);
    atualizar();
  }

  configurarCampo("#temCnpj", "campoCnpj", "Sim");
  configurarCampo("#temCnpj", "campoFormacao", "Não");
  configurarCampo("#temPlano", "campoPlano", "Sim");

  const formulario = document.getElementById("cotacaoForm");

  if (formulario) {
    formulario.addEventListener("submit", function (evento) {
      evento.preventDefault();

      const dados = new FormData(formulario);
      const resposta = function (campo) {
        return (dados.get(campo) || "").toString().trim() || "Não informado";
      };

      const mensagem = [
        "Olá, André! Gostaria de solicitar uma cotação de plano de saúde.",
        "",
        "CNPJ: " + resposta("temCnpj"),
        "Número do CNPJ: " + resposta("cnpj"),
        "Formação acadêmica/curso: " + resposta("formacao"),
        "Possui dependentes: " + resposta("temDependentes"),
        "Idades dos beneficiários: " + resposta("idades"),
        "Hospitais/laboratórios preferidos: " + resposta("preferencias"),
        "Região/cidade: " + resposta("regiao"),
        "Possui plano atualmente: " + resposta("temPlano"),
        "Plano atual: " + resposta("planoAtual")
      ].join("\n");

      window.open(
        "https://wa.me/" + numero + "?text=" + encodeURIComponent(mensagem),
        "_blank"
      );
    });
  }

  const ano = document.getElementById("year");
  if (ano) ano.textContent = new Date().getFullYear();

  const compartilhar = document.getElementById("shareButton");

  if (compartilhar) {
    compartilhar.addEventListener("click", async function () {
      const dados = {
        title: "André Linares | Planos de Saúde",
        text: "Conheça meu cartão digital e solicite sua cotação!",
        url: window.location.href
      };

      if (navigator.share) {
        try {
          await navigator.share(dados);
        } catch (erro) {}
      } else {
        try {
          await navigator.clipboard.writeText(dados.url);
          alert("Link do cartão copiado!");
        } catch (erro) {
          alert("Copie o link pela barra do navegador.");
        }
      }
    });
  }
});
